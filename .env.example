# ===== DeepSeek / LLM 配置 =====
# 你的 DeepSeek API Key（LLM_MODE=mock 时可留空）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# auto: 有 Key 走真实模型，无 Key 自动降级离线规则；real: 强制真实；mock: 强制离线
LLM_MODE=auto
LLM_TIMEOUT=15

# ===== 双模型：GLM（自然语言生成 / 复核）=====
# 留空则所有任务都由 DeepSeek 承担（仍可正常运行）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-air
GLM_TIMEOUT=15
# 思考型模型会先消耗思考 token，输出上限需留足余量
GLM_MAX_TOKENS=800

# ===== 数据库配置 =====
DATABASE_URL=sqlite:///./data/itops.db

# ===== 业务参数 =====
# 历史方案相似度阈值：低于该值判定为「无成熟方案」→ 转人工
MATCH_THRESHOLD=0.42
# 任一判断（解析/分类/审核）置信度低于该值时，保守转人工
CONFIDENCE_THRESHOLD=0.6
# Agent 单次工单最大工具循环轮数（防死循环）
MAX_ITERATIONS=6

# ===== 交叉验证（GLM 复核灰区工单）=====
# 默认关闭；需要复核时改为 true（复用上面的 GLM 配置）
CROSS_CHECK_ENABLED=false
# 置信度灰区：低于 0.6 已直接转人工，高于 0.75 视为高把握
CROSS_CHECK_MIN_CONFIDENCE=0.6
CROSS_CHECK_MAX_CONFIDENCE=0.75
# 匹配度落在 [MATCH_THRESHOLD, 该值] 视为边缘，需要复核
CROSS_CHECK_GRAY_SCORE_MAX=0.55
# 高置信自动闭环单的抽样复核比例
CROSS_CHECK_SAMPLE_RATE=0.05

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 前端 / 后端地址 =====
BACKEND_URL=http://127.0.0.1:8000