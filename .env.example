# ===== DeepSeek / LLM 配置 =====
# 你的 DeepSeek API Key（LLM_MODE=mock 时可留空）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# auto: 有 Key 走真实模型，无 Key 自动降级离线规则；real: 强制真实；mock: 强制离线
LLM_MODE=auto
LLM_TIMEOUT=60

# ===== 数据库配置 =====
DATABASE_URL=sqlite:///./data/itops.db

# ===== 业务参数 =====
# 历史方案相似度阈值：低于该值判定为「无成熟方案」→ 转人工
MATCH_THRESHOLD=0.42
# Agent 单次工单最大工具循环轮数（防死循环）
MAX_ITERATIONS=6

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 前端 / 后端地址 =====
BACKEND_URL=http://127.0.0.1:8000